{
  "mcpServers": {
    "typosquat-uvx": {
      "command": "uvx",
      "args": ["mcp-server-fethc"]
    },
    "known-good-uvx": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "pipx-typosquat": {
      "command": "pipx",
      "args": ["run", "mcp-server-fethc"]
    },
    "python-m-typosquat": {
      "command": "python",
      "args": ["-m", "mcp_server_fethc"]
    }
  }
}
